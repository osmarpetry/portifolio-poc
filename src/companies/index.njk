---
layout: layouts/base.njk
canonicalPath: /companies/
permalink: /companies/index.html
pageTitle: "Company Work — Osmar Petry"
---
<section class="section section-companies-index" aria-labelledby="companies-index-heading">
  <div class="container">

    <div class="section-heading">
      <p class="eyebrow">Company Work</p>
      <h1 id="companies-index-heading">Companies.</h1>
      <p>
        Professional work across {{ companies | length }} companies — from enterprise platforms to
        startup products, consulting engagements, and academic research.
      </p>
    </div>

    {% for company in companies %}
      <section class="tier-section" id="company-{{ company.slug }}">
        <div class="section-heading">
          <a class="section-heading-link" href="/companies/#company-{{ company.slug }}">
            <p class="eyebrow">Company {% if loop.index < 10 %}0{% endif %}{{ loop.index }}</p>
            <h2>{{ company.name }}</h2>
            <p>{{ company.role }} · {{ company.period }}. {{ company.summary }}</p>
          </a>
        </div>
        {% if company.projects and company.projects.length %}
          <div class="project-grid">
            {% for project in company.projects %}
              {% set projectAliases = project.repos or [] %}
              <div
                class="project-card-frame"
                id="{{ project.slug }}"
                data-project-card="{{ project.slug }}"
                {% if projectAliases | length %}data-project-aliases="{{ projectAliases | join(",") }}"{% endif %}
              >
                <article class="project-card">
                  <div class="project-media{% if project.images | length > 1 %} project-media--gallery{% endif %}">
                    {% for image in project.images %}
                      {% responsiveImage
                        image.src,
                        image.alt,
                        "(max-width: 900px) 100vw, 50vw",
                        {
                          loading: "lazy",
                          decoding: "async",
                          widths: [480, 768, 1024, 1280, 1600],
                          width: 1600,
                          height: 1000
                        }
                      %}
                    {% endfor %}
                  </div>
                  <div class="project-body">
                    <p class="project-type">{{ project.type }}</p>
                    <h3>{{ project.title }}</h3>
                    <p class="project-summary">{{ project.summary }}</p>
                    {% if project.stack %}
                      <p class="stack-line">
                        <span>Stack</span>{{ project.stack | join(" · ") }}
                      </p>
                    {% endif %}
                    {% if project.links %}
                      <div class="project-links">
                        {% for link in project.links %}
                          <a href="{{ link.url }}" target="_blank" rel="noreferrer">{{ link.label }}</a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </article>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </section>
    {% endfor %}

  </div>
</section>
