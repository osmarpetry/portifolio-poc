---
layout: layouts/base.njk
canonicalPath: /companies/
pageTitle: "Company Work — Osmar Petry"
---
<section class="section section-companies-index" aria-labelledby="companies-index-heading">
  <div class="container">

    <div class="section-heading">
      <p class="eyebrow">Company Work</p>
      <h1 id="companies-index-heading">Companies.</h1>
      <p>
        Professional work across {{ companies | length }} companies — from enterprise platforms to
        startup products, consulting engagements, and academic research.
      </p>
    </div>

    {% for company in companies %}
      {% set sectionId = "company-" ~ company.slug %}
      {% set sectionEyebrow %}Company {% if loop.index < 10 %}0{% endif %}{{ loop.index }}{% endset %}
      {% set sectionTitle = company.name %}
      {% set sectionTitleHref = "/companies/#company-" ~ company.slug %}
      {% set sectionDescription = company.role ~ " · " ~ company.period ~ ". " ~ company.summary %}
      {% set sectionProjects = company.projects %}
      {% set sectionCtaUrl = "" %}
      {% set sectionCtaLabel = "" %}
      {% set sectionClass = "" %}
      {% set sectionDataTier = "" %}
      {% set sectionHidden = false %}
      {% include "partials/project-tier-section.njk" %}
    {% endfor %}

  </div>
</section>
