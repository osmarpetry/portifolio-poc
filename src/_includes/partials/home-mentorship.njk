<section class="section section-mentorship" id="mentorship">
  <div class="container">
    <div class="mentorship-layout">
      <div class="mentorship-visual">
        {% for image in contactProject.images %}
          <img
            src="{{ image.src }}"
            alt="{{ image.alt }}"
            class="mentorship-visual__photo mentorship-visual__photo--{{ loop.index }}"
            loading="lazy"
            decoding="async"
          />
        {% endfor %}
      </div>

      <div class="mentorship-info">
        <span class="mentorship-info__label">Mentorship</span>
        <h2 class="mentorship-info__title">Helping engineers grow</h2>
        <p class="mentorship-info__text">Frontend, product thinking, and engineering judgment.</p>
        <a
          href="{{ contactProject.links[0].url }}"
          target="_blank"
          rel="noreferrer"
          class="mentorship-info__link"
        >
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
