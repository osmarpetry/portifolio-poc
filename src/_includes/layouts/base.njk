<!doctype html>
<html lang="en">
  <head>
    {% set resolvedTitle = pageTitle or title or site.title %}
    {% set resolvedDescription = description or site.description %}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ resolvedTitle }}</title>
    <meta name="description" content="{{ resolvedDescription }}" />
    <meta name="theme-color" content="{{ site.themeColor }}" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="{{ site.shortName }}" />
    <link rel="canonical" href="{{ site.url }}{{ canonicalPath or page.url }}" />
    <meta property="og:title" content="{{ resolvedTitle }}" />
    <meta property="og:description" content="{{ resolvedDescription }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:url" content="{{ site.url }}{{ canonicalPath or page.url }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/assets/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      {% include "partials/nav.njk" %}
    </header>
    <main id="main">
      {{ content | safe }}
    </main>
    {% if showAboutAtPageEnd != false and (canonicalPath or page.url) != "/" %}
      <section class="section section-about" id="about">
        <div class="container about-shell">
          <div class="about-banner">
            {% responsiveImage
              "/assets/images/hero/osmar-about.jpeg",
              "",
              "100vw",
              {
                className: "about-media",
                imgClassName: "about-media__image",
                loading: "lazy",
                decoding: "async",
                widths: [640, 960, 1280, 1600]
              }
            %}
            <div class="about-card">
              <p class="eyebrow">About</p>
              <h2>About me</h2>
              <div class="about-copy">
                <p>
                  Based in Luxembourg, I work best in frontend-focused full
                  stack product environments where UI quality, backend
                  integrations, testing, performance, and developer experience
                  all need to hold together in production.
                </p>
                <p>
                  The strongest fit is product platform work across web and
                  mobile: scheduling, admin surfaces, operational workflows,
                  realtime behavior, and maintainable systems that other
                  engineers can extend safely as the product grows.
                </p>
              </div>
              <div class="about-links">
                <a href="{{ site.github }}" target="_blank" rel="noreferrer">GitHub</a>
                <a href="{{ site.linkedin }}" target="_blank" rel="noreferrer">LinkedIn</a>
                <a href="mailto:{{ site.email }}">Email</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    {% endif %}
    {% include "partials/footer.njk" %}
    <script src="/assets/js/pwa.js" defer></script>
    <script src="/assets/js/projects-query.js" defer></script>
    <script src="/assets/js/content-page.js" defer></script>
  </body>
</html>
