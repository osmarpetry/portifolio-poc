<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle or site.title }}</title>
    <meta name="description" content="{{ site.description }}" />
    <meta name="theme-color" content="{{ site.themeColor }}" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="{{ site.shortName }}" />
    <link rel="canonical" href="{{ site.url }}{{ canonicalPath or page.url }}" />
    <meta property="og:title" content="{{ pageTitle or site.title }}" />
    <meta property="og:description" content="{{ site.description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ canonicalPath or page.url }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/assets/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      {% include "partials/nav.njk" %}
    </header>
    <main id="main">
      {{ content | safe }}
    </main>
    {% if showAboutAtPageEnd != false and (canonicalPath or page.url) != "/" %}
      {% include "partials/about.njk" %}
    {% endif %}
    {% include "partials/footer.njk" %}
    <script src="/assets/js/pwa.js" defer></script>
    <script src="/assets/js/projects-query.js" defer></script>
  </body>
</html>
