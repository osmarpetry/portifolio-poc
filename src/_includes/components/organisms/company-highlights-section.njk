<section class="section section-company-highlights" id="company-work" aria-labelledby="company-highlights-heading">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Company Work</p>
      <h2 id="company-highlights-heading">
        <a class="section-title-link" href="/#company-work">Companies and products.</a>
      </h2>
      <p>One project per company on the landing page, with the full company breakdown kept in the dedicated company page.</p>
    </div>

    <div class="project-grid">
      {% for project in catalog.homeCompanyProjects %}
        <div class="project-card-frame" id="company-highlight-{{ project.companySlug }}">
          <article class="project-card">
            <div class="project-media{% if project.images | length > 1 %} project-media--gallery{% endif %}">
              {% for image in project.images %}
                {% responsiveImage
                  image.src,
                  image.alt,
                  "(max-width: 900px) 100vw, 50vw",
                  {
                    loading: "lazy",
                    decoding: "async",
                    widths: [480, 768, 1024, 1280, 1600],
                    width: 1600,
                    height: 1000
                  }
                %}
              {% endfor %}
            </div>
            <div class="project-body">
              <p class="project-type">{{ project.type }}</p>
              <h3>{{ project.title }}</h3>
              <p class="project-summary">{{ project.summary }}</p>
              {% if project.stack %}
                <p class="stack-line">
                  <span>Stack</span>{{ project.stack | join(" · ") }}
                </p>
              {% endif %}
              {% if project.links %}
                <div class="project-links">
                  {% for link in project.links %}
                    <a href="{{ link.url }}" target="_blank" rel="noreferrer">{{ link.label }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </article>
        </div>
      {% endfor %}
    </div>

    <div class="tier-section__cta">
      <a class="action-link action-link--tier" href="/companies/">See all company projects</a>
    </div>
  </div>
</section>
