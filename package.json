    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@storybook/html-vite": "^10.3.4",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.32.0",
    "nunjucks": "^3.2.4",
    "playwright": "^1.55.1",
    "sharp": "^0.34.5",
    "storybook": "^10.3.4",
    "terser": "^5.46.1"
  }
}
